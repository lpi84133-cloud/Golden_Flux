<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Core -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Notifications (Android 13+) — used for push permission prompt -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Short haptic pulse on build/merge/upgrade; the player can turn it off in Settings. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Install referrer used by AppsFlyer attribution -->
    <uses-permission android:name="com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE" />

    <!-- Camera is optional and requested at runtime only for the player avatar. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".GoldenFluxApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="${fluxAppLabel}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:supportsRtl="false"
        android:theme="@style/Theme.Flux"
        tools:targetApi="33"
        tools:replace="android:allowBackup,android:dataExtractionRules,android:fullBackupContent">

        <!-- Router — the sole LAUNCHER (pitfalls #2).
             Theme.Flux.Launch adopts the Android 12+ SplashScreen API on
             API 31+; on older versions it degrades to a fullscreen theme
             with the branded background colour. -->
        <activity
            android:name=".flux.entry.LaunchArbiter"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density"
            android:theme="@style/Theme.Flux.Launch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Offline screen -->
        <activity
            android:name=".flux.stage.OfflineActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density"
            android:theme="@style/Theme.Flux.Fullscreen" />

        <!-- Notification permission screen -->
        <activity
            android:name=".flux.stage.PromoActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density"
            android:theme="@style/Theme.Flux.Fullscreen" />

        <!-- WebView shell -->
        <activity
            android:name=".flux.stage.StageActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden"
            android:theme="@style/Theme.Flux.Stage" />

        <!-- Game — NOT the launcher any more; started by LaunchArbiter. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density"
            android:theme="@style/Theme.GoldenFlux" />

        <!-- FCM -->
        <service
            android:name=".flux.signal.FluxPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notif_flux" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/gf_gold" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="${fluxPushChannel}" />

        <!-- Disable Firebase analytics data collection until the user accepts. -->
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
