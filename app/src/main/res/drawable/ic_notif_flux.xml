<?xml version="1.0" encoding="utf-8"?>
<!--
    Monochrome, alpha-only notification icon. Android's system tint fills it;
    any colour in this asset is discarded and a full-colour icon renders as a
    white blob (kotlin_fingerprint.mdc §6, custom_screens.md §5).

    Golden Flux glyph: a four-point sparkle over a rounded pedestal, echoing
    the game's core artefact without borrowing the launcher shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?android:attr/colorControlNormal">

    <!-- Four-point sparkle -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,2 L13.6,9.4 L21,12 L13.6,14.6 L12,22 L10.4,14.6 L3,12 L10.4,9.4 Z" />
    <!-- Small satellite spark -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M19.5,4 L20,6 L22,6.5 L20,7 L19.5,9 L19,7 L17,6.5 L19,6 Z" />
</vector>
