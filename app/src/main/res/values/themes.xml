<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- The game keeps its own Material theme. -->
    <style name="Theme.GoldenFlux" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/gf_background</item>
        <item name="android:navigationBarColor">@color/gf_background</item>
        <item name="android:windowBackground">@color/gf_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Base for the gray Activities (Compose is not used here). -->
    <style name="Theme.Flux" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <style name="Theme.Flux.Fullscreen" parent="Theme.Flux">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!--
        Theme for LaunchArbiter (the launcher activity). On API < 31 this
        is just a fullscreen Flux theme with the branded background so no
        white flash occurs before our own LaunchSplash draws. On API 31+
        the values-v31 override adds the SplashScreen attributes.
    -->
    <style name="Theme.Flux.Launch" parent="Theme.Flux.Fullscreen">
        <item name="android:windowBackground">@color/launch_bg</item>
        <item name="android:statusBarColor">@color/launch_bg</item>
        <item name="android:navigationBarColor">@color/launch_bg</item>
    </style>

    <!--
        WebView host theme. Disables the launch-preview window so no
        white/system flash is visible while the WebView initialises or when
        the user navigates away from a page (pitfalls #8).
    -->
    <style name="Theme.Flux.Stage" parent="Theme.Flux">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
